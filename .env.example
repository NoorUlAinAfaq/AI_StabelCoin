# Copy this file to .env and fill in your values
# Never commit .env to git

# Your wallet private key (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# RPC URL from Alchemy or Infura for Base Sepolia
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Basescan API key for contract verification (get from https://basescan.org)
BASESCAN_API_KEY=your_basescan_api_key_here

# Set to "true" to print gas usage after tests
REPORT_GAS= true
